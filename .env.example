# ---------------------------------------------------------------------------
# GeoSage environment template
# Copy this file to ".env" and adjust the values.
# ---------------------------------------------------------------------------

# development | testing | production
FLASK_CONFIG=development

# Use a long random string in any shared/real deployment
SECRET_KEY=change-this-to-a-long-random-string

# Optional database override (default: database/geosage.db inside the project)
# DATABASE_URL=sqlite:///C:/path/to/geosage.db
